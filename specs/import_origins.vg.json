          "as": "name"
        },
        {
          "lookup": "name",
          "from": {
            "data": {
              "url": "data/brand_countries.csv"
            },
            "key": "headquarters",
            "fields": [
              "home_region"
            ]
          }
        },
        {
          "calculate": "isValid(datum.home_region) ? 'Yes' : 'No'",
          "as": "brand_home"
        },
        {
          "calculate": "datum.aud_per_camera < 250 ? 'Under A$250' : datum.aud_per_camera < 750 ? 'A$250 to A$750' : datum.aud_per_camera < 1500 ? 'A$750 to A$1,500' : 'A$1,500 or more'",
          "as": "per_class"
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.9
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "qty_units",
          "type": "quantitative",
          "scale": {
            "domain": [
              19909,
              4840780
            ],
            "range": [
              90,
              3200
            ],
            "zero": false
          },
          "legend": {
            "title": "Cameras imported",
            "orient": "none",
            "legendX": 523,
            "legendY": 205,
            "values": [
              50000,
              1000000,
              4000000
            ],
            "labelExpr": "datum.value < 1e6 ? format(datum.value, ',') : format(datum.value/1e6, '.0f') + ' million'",
            "symbolFillColor": "#9ecae1",
            "symbolStrokeColor": "#ffffff"
          }
        },
        "color": {
          "field": "per_class",
          "type": "ordinal",
          "scale": {
            "domain": [
              "Under A$250",
              "A$250 to A$750",
              "A$750 to A$1,500",
              "A$1,500 or more"
            ],
            "range": [
              "#c6dbef",
              "#6baed6",
              "#2171b5",
              "#08306b"
            ]
          },
          "legend": {
            "title": "Average value per camera",
            "symbolType": "circle",
            "symbolSize": 180,
            "orient": "none",
            "legendX": 680,
            "legendY": 205
          }
        },
        "stroke": {
          "value": "#ffffff"
        },
        "strokeWidth": {
          "value": 1
        },
        "order": {
          "field": "qty_units",
          "sort": "descending"
        },
        "tooltip": [
          {
            "field": "name",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "qty_units",
            "type": "quantitative",
            "title": "Cameras",
            "format": ","
          },
          {
            "field": "aud_per_camera",
