{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Proportional symbol map of Australia's 2025 camera imports by country of origin (UN Comtrade, Australia's ten biggest suppliers by value): circle size shows the number of cameras, colour shows the average value per camera; rings mark countries where camera brands are headquartered (brand headquarters list).",
  "config": {
    "font": "Manrope",
    "view": {
      "stroke": null
    },
    "title": {
      "anchor": "middle",
      "fontSize": 13,
      "fontWeight": "normal",
      "color": "#52514e",
      "frame": "group",
      "offset": 12
    },
    "axis": {
      "labelColor": "#52514e",
      "titleColor": "#52514e",
      "titleFontWeight": "normal",
      "gridColor": "#e8e7e4",
      "domainColor": "#c3c2b7",
      "tickColor": "#c3c2b7"
    },
    "legend": {
      "titleLimit": 300,
      "labelLimit": 300,
      "labelColor": "#52514e",
      "titleColor": "#52514e",
      "titleFontWeight": "normal",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "layout": {
        "bottom": {
          "anchor": "middle"
        }
      }
    },
    "axisY": {
      "minExtent": 80,
      "maxExtent": 80
    }
  },
  "background": "transparent",
  "title": {
    "text": "Cameras imported into Australia, 2025: how many came from each country, and what each was worth",
    "subtitle": "Hover over a circle for exact figures",
    "subtitleFontStyle": "italic",
    "subtitleColor": "#52514e",
    "subtitleFontSize": 12
  },
  "width": 840,
  "height": 420,
  "projection": {
    "type": "equalEarth",
    "rotate": [
      -150,
      0,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "filter": "datum.id != '010'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#e4dfd4",
        "stroke": "#faf7f2",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "filter": "datum.id == '036'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#9b2c2c",
        "stroke": "#faf7f2",
        "strokeWidth": 0.5
      },
      "encoding": {
        "tooltip": {
          "value": "Australia"
        }
      }
    },
    {
      "data": {
        "url": "data/comtrade_au_camera_imports_2022-2025.csv",
        "format": {
          "parse": {
            "year": "number",
            "partner_code": "number",
            "value_usd": "number",
            "qty_units": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.year == 2025"
        },
        {
          "filter": "datum.partner_code != 0 && datum.partner_code != 36"
        },
        {
          "calculate": "datum.value_usd / 0.6449 / 1000000",
          "as": "value_aud_m"
        },
        {
          "filter": "datum.qty_units > 0"
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "rank"
            }
          ],
          "sort": [
            {
              "field": "value_usd",
              "order": "descending"
            }
          ]
        },
        {
          "filter": "datum.rank <= 10"
        },
        {
          "calculate": "datum.value_usd / datum.qty_units / 0.6449",
          "as": "aud_per_camera"
        },
        {
          "lookup": "partner_code",
          "from": {
            "data": {
              "values": [
                {
                  "partner_code": 156,
                  "lon": 104,
                  "lat": 35
                },
