                ]
              },
              "legend": null
            }
          },
          "transform": [
            {
              "filter": "datum.measure_key == 'brand_share'"
            }
          ]
        },
        {
          "mark": {
            "type": "text",
            "dy": 18,
            "fontSize": 12,
            "fontWeight": 600
          },
          "encoding": {
            "y": {
              "field": "region",
              "type": "nominal",
              "title": null,
              "sort": [
                "Japan",
