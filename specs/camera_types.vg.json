{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Digital camera shipments by type, 1999 to 2025, shown as a stream graph (CIPA).",
  "config": {
    "font": "Manrope",
    "view": {
      "stroke": null
    },
    "title": {
      "anchor": "middle",
      "fontSize": 13,
      "fontWeight": "normal",
      "color": "#52514e",
      "frame": "group",
      "offset": 12
    },
    "axis": {
      "labelColor": "#52514e",
      "titleColor": "#52514e",
      "titleFontWeight": "normal",
      "gridColor": "#e8e7e4",
      "domainColor": "#c3c2b7",
      "tickColor": "#c3c2b7"
    },
    "axisY": {
      "minExtent": 80,
      "maxExtent": 80
    },
    "legend": {
      "layout": {
        "bottom": {
          "anchor": "middle"
        }
      }
    }
  },
  "background": "transparent",
  "title": {
    "text": "Digital cameras shipped worldwide each year, by type",
    "subtitle": "The thicker the band, the more cameras were shipped that year",
    "subtitleFontSize": 13,
    "subtitleColor": "#52514e",
    "subtitleFontStyle": "italic",
    "subtitlePadding": 4
  },
  "width": 840,
  "height": 340,
  "layer": [
    {
      "data": {
        "url": "data/cipa_digital_by_type_1999-2025.csv",
        "format": {
          "parse": {
            "year": "number",
            "compact_thousand_units": "number",
            "interchangeable_thousand_units": "number"
          }
        }
      },
      "transform": [
        {
          "calculate": "datum.compact_thousand_units / 1000",
          "as": "Compact"
        },
        {
          "calculate": "isValid(datum.interchangeable_thousand_units) ? datum.interchangeable_thousand_units / 1000 : 0",
          "as": "Interchangeable-lens"
        },
        {
          "fold": [
            "Compact",
            "Interchangeable-lens"
          ],
          "as": [
            "camera_type",
            "shipped_millions"
          ]
        }
      ],
      "mark": {
        "type": "area",
        "interpolate": "monotone"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "title": null,
          "scale": {
            "domain": [
              1999,
              2025
            ]
          },
          "axis": {
            "format": "d",
            "values": [
              1999,
              2005,
              2010,
              2015,
              2020,
              2025
            ],
            "grid": false
          }
        },
        "y": {
          "field": "shipped_millions",
          "type": "quantitative",
          "stack": "center",
          "scale": {
            "domain": [
              0,
              138
            ]
          },
          "axis": null
        },
        "color": {
          "field": "camera_type",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "Compact",
              "Interchangeable-lens"
            ],
            "range": [
              "#9cc0ec",
              "#2a78d6"
            ]
          }
        },
        "order": {
          "field": "camera_type",
          "sort": "descending"
        },
        "tooltip": [
          {
            "field": "year",
            "type": "quantitative",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "camera_type",
            "type": "nominal",
            "title": "Type"
          },
          {
            "field": "shipped_millions",
            "type": "quantitative",
            "title": "Shipped (millions)",
            "format": ".1f"
          }
        ]
      }
    },
