{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Share of interchangeable-lens cameras that were DSLR or mirrorless in 2012, 2020 and 2025 (CIPA), as waffle charts of 100 squares.",
  "config": {
    "font": "Manrope",
    "view": {
      "stroke": null
    },
    "title": {
      "anchor": "middle",
      "fontSize": 13,
      "fontWeight": "normal",
      "color": "#52514e",
      "frame": "group",
      "offset": 12
    },
    "axis": {
      "labelColor": "#52514e",
      "titleColor": "#52514e",
      "titleFontWeight": "normal",
      "gridColor": "#e8e7e4",
      "domainColor": "#c3c2b7",
      "tickColor": "#c3c2b7"
    },
    "axisY": {
      "minExtent": 80,
      "maxExtent": 80
    },
    "legend": {
      "layout": {
        "bottom": {
          "anchor": "middle"
        }
      }
    }
  },
  "background": "transparent",
  "title": {
    "text": "Out of every 100 interchangeable-lens cameras shipped worldwide",
    "anchor": "middle",
    "frame": "bounds"
  },
  "hconcat": [
    {
      "title": {
        "text": "2012",
        "fontSize": 16,
        "fontWeight": 600,
        "color": "#2b2a28",
        "anchor": "middle",
        "subtitle": "8 in 10 were DSLRs",
        "subtitleFontSize": 13,
        "subtitleColor": "#52514e"
      },
      "width": 240,
      "height": 240,
      "data": {
        "sequence": {
          "start": 0,
          "stop": 100,
          "as": "idx"
        }
      },
      "transform": [
        {
          "calculate": "2012",
          "as": "year"
        },
        {
          "lookup": "year",
          "from": {
            "data": {
              "url": "data/cipa_digital_by_type_1999-2025.csv",
              "format": {
                "parse": {
                  "year": "number",
                  "dslr_thousand_units": "number",
                  "mirrorless_thousand_units": "number"
                }
              }
            },
            "key": "year",
            "fields": [
              "dslr_thousand_units",
              "mirrorless_thousand_units"
            ]
          }
        },
        {
          "calculate": "round(100 * toNumber(datum.dslr_thousand_units) / (toNumber(datum.dslr_thousand_units) + toNumber(datum.mirrorless_thousand_units)))",
          "as": "dslr_pct"
        },
        {
          "calculate": "datum.idx < datum.dslr_pct ? 'DSLR' : 'Mirrorless'",
          "as": "type"
        },
        {
          "calculate": "datum.type == 'DSLR' ? datum.dslr_pct : 100 - datum.dslr_pct",
          "as": "pct"
        },
        {
          "calculate": "datum.type == 'DSLR' ? toNumber(datum.dslr_thousand_units) / 1000 : toNumber(datum.mirrorless_thousand_units) / 1000",
          "as": "units_m"
        },
        {
          "calculate": "datum.idx % 10",
          "as": "col"
        },
        {
          "calculate": "floor(datum.idx / 10)",
          "as": "row"
        }
      ],
      "mark": {
        "type": "square",
        "size": 324,
        "opacity": 1
      },
      "encoding": {
        "x": {
          "field": "col",
          "type": "ordinal",
          "axis": null
        },
        "y": {
          "field": "row",
          "type": "ordinal",
          "axis": null
        },
        "color": {
          "field": "type",
          "type": "nominal",
          "scale": {
            "domain": [
              "DSLR",
              "Mirrorless"
            ],
            "range": [
              "#c9c6bd",
              "#2a78d6"
            ]
          },
          "legend": {
            "title": null,
            "orient": "bottom",
            "direction": "horizontal",
            "symbolType": "square",
            "labelFontSize": 12
          }
        },
        "tooltip": [
          {
            "field": "year",
            "type": "quantitative",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "type",
            "title": "Type"
          },
          {
            "field": "pct",
            "type": "quantitative",
            "title": "Share (%)"
          },
          {
            "field": "units_m",
            "type": "quantitative",
            "title": "Shipped (millions)",
            "format": ".2f"
          }
        ]
      }
    },
    {
      "title": {
        "text": "2020",
        "fontSize": 16,
        "fontWeight": 600,
        "color": "#2b2a28",
        "anchor": "middle",
        "subtitle": "Mirrorless takes the lead",
        "subtitleFontSize": 13,
        "subtitleColor": "#52514e"
      },
      "width": 240,
      "height": 240,
      "data": {
        "sequence": {
          "start": 0,
          "stop": 100,
          "as": "idx"
        }
      },
      "transform": [
        {
          "calculate": "2020",
          "as": "year"
        },
        {
          "lookup": "year",
          "from": {
            "data": {
              "url": "data/cipa_digital_by_type_1999-2025.csv",
              "format": {
                "parse": {
                  "year": "number",
                  "dslr_thousand_units": "number",
                  "mirrorless_thousand_units": "number"
                }
              }
            },
            "key": "year",
            "fields": [
              "dslr_thousand_units",
              "mirrorless_thousand_units"
            ]
          }
        },
        {
          "calculate": "round(100 * toNumber(datum.dslr_thousand_units) / (toNumber(datum.dslr_thousand_units) + toNumber(datum.mirrorless_thousand_units)))",
          "as": "dslr_pct"
        },
        {
          "calculate": "datum.idx < datum.dslr_pct ? 'DSLR' : 'Mirrorless'",
          "as": "type"
        },
        {
          "calculate": "datum.type == 'DSLR' ? datum.dslr_pct : 100 - datum.dslr_pct",
          "as": "pct"
        },
        {
          "calculate": "datum.type == 'DSLR' ? toNumber(datum.dslr_thousand_units) / 1000 : toNumber(datum.mirrorless_thousand_units) / 1000",
          "as": "units_m"
        },
        {
          "calculate": "datum.idx % 10",
          "as": "col"
        },
        {
          "calculate": "floor(datum.idx / 10)",
          "as": "row"
        }
      ],
      "mark": {
        "type": "square",
        "size": 324,
        "opacity": 1
      },
      "encoding": {
        "x": {
          "field": "col",
          "type": "ordinal",
          "axis": null
        },
        "y": {
          "field": "row",
          "type": "ordinal",
          "axis": null
        },
        "color": {
          "field": "type",
          "type": "nominal",
          "scale": {
            "domain": [
              "DSLR",
              "Mirrorless"
            ],
            "range": [
              "#c9c6bd",
              "#2a78d6"
            ]
          },
          "legend": {
            "title": null,
            "orient": "bottom",
            "direction": "horizontal",
            "symbolType": "square",
            "labelFontSize": 12
          }
        },
        "tooltip": [
          {
            "field": "year",
            "type": "quantitative",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "type",
            "title": "Type"
          },
          {
            "field": "pct",
            "type": "quantitative",
            "title": "Share (%)"
          },
          {
            "field": "units_m",
            "type": "quantitative",
            "title": "Shipped (millions)",
            "format": ".2f"
          }
        ]
      }
    },
    {
      "title": {
        "text": "2025",
        "fontSize": 16,
        "fontWeight": 600,
        "color": "#2b2a28",
        "anchor": "middle",
        "subtitle": "9 in 10 are mirrorless",
        "subtitleFontSize": 13,
        "subtitleColor": "#52514e"
      },
      "width": 240,
      "height": 240,
      "data": {
        "sequence": {
          "start": 0,
          "stop": 100,
          "as": "idx"
        }
      },
      "transform": [
        {
          "calculate": "2025",
          "as": "year"
        },
        {
          "lookup": "year",
          "from": {
            "data": {
              "url": "data/cipa_digital_by_type_1999-2025.csv",
              "format": {
                "parse": {
                  "year": "number",
                  "dslr_thousand_units": "number",
                  "mirrorless_thousand_units": "number"
                }
              }
            },
