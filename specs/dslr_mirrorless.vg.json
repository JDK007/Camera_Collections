          "as": "units_m"
        },
        {
          "calculate": "datum.idx % 10",
          "as": "col"
        },
        {
          "calculate": "floor(datum.idx / 10)",
          "as": "row"
        }
      ],
      "mark": {
        "type": "square",
        "size": 324,
        "opacity": 1
      },
      "encoding": {
        "x": {
          "field": "col",
          "type": "ordinal",
          "axis": null
        },
        "y": {
          "field": "row",
          "type": "ordinal",
          "axis": null
        },
        "color": {
          "field": "type",
          "type": "nominal",
          "scale": {
            "domain": [
              "DSLR",
              "Mirrorless"
            ],
            "range": [
              "#c9c6bd",
              "#2a78d6"
            ]
          },
          "legend": {
            "title": null,
            "orient": "bottom",
            "direction": "horizontal",
            "symbolType": "square",
            "labelFontSize": 12
          }
        },
        "tooltip": [
          {
            "field": "year",
            "type": "quantitative",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "type",
            "title": "Type"
          },
          {
            "field": "pct",
            "type": "quantitative",
            "title": "Share (%)"
          },
          {
            "field": "units_m",
            "type": "quantitative",
            "title": "Shipped (millions)",
            "format": ".2f"
          }
        ]
      }
    }
  ],
  "spacing": 60,
  "resolve": {
    "legend": {
      "color": "shared"
    }
  },
  "padding": {
    "left": 80,
    "top": 5,
    "right": 80,
    "bottom": 5
  },
  "bounds": "flush"
}