{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "The brand wars: a heatmap of how many camera models each brand released per year, 1999-2007 (1000 Cameras Dataset).",
  "config": {
    "font": "Manrope",
    "view": {
      "stroke": null
    },
    "title": {
      "anchor": "middle",
      "fontSize": 13,
      "fontWeight": "normal",
      "color": "#52514e",
      "frame": "group",
      "offset": 12
    },
    "axis": {
      "labelColor": "#52514e",
      "titleColor": "#52514e",
      "titleFontWeight": "normal",
      "gridColor": "#e8e7e4",
      "domainColor": "#c3c2b7",
      "tickColor": "#c3c2b7"
    },
    "axisY": {
      "minExtent": 80,
      "maxExtent": 80
    },
    "legend": {
      "layout": {
        "bottom": {
          "anchor": "middle"
        }
      }
    }
  },
  "bounds": "flush",
  "spacing": 56,
  "vconcat": [
    {
      "title": "Models in the 1000 Cameras Dataset released by each brand, 1999–2007 (darker = more models)",
      "width": 840,
      "height": {
        "step": 22
      },
      "data": {
        "url": "data/cameras_1000_specs_1994-2007.csv",
        "format": {
          "type": "csv",
          "parse": {
            "Release date": "number"
          }
        }
      },
      "transform": [
        {
          "calculate": "datum['Release date']",
          "as": "year"
        },
        {
          "filter": "datum.year >= 1999"
        },
        {
          "calculate": "split(datum.Model, ' ')[0]",
          "as": "brand"
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "models"
            }
          ],
          "groupby": [
            "brand",
            "year"
          ]
        },
        {
          "joinaggregate": [
            {
              "op": "sum",
              "field": "models",
              "as": "brand_total"
            }
          ],
          "groupby": [
            "brand"
          ]
        }
      ],
      "mark": {
        "type": "rect",
        "stroke": "#faf7f2",
        "strokeWidth": 2,
        "cornerRadius": 2
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "scale": {
            "domain": [
              1999,
              2000,
              2001,
              2002,
              2003,
              2004,
              2005,
              2006,
              2007
            ]
          },
          "axis": {
            "title": null,
            "labelAngle": 0,
            "orient": "bottom",
            "domain": false,
            "ticks": false
          }
        },
        "y": {
          "field": "brand",
          "type": "nominal",
          "sort": {
            "field": "brand_total",
            "op": "max",
            "order": "descending"
          },
          "axis": {
            "title": null,
            "domain": false,
            "ticks": false,
            "labelPadding": 6
          }
        },
        "color": {
          "field": "models",
          "type": "quantitative",
          "scale": {
            "scheme": "blues",
            "domain": [
              0,
              21
            ]
          },
          "legend": {
            "title": "Models released",
            "orient": "bottom",
            "gradientLength": 220,
            "titleFontWeight": "normal",
            "direction": "horizontal"
          }
        },
        "tooltip": [
          {
            "field": "brand",
            "type": "nominal",
            "title": "Brand"
          },
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "models",
            "type": "quantitative",
            "title": "Models released"
          },
          {
            "field": "brand_total",
            "type": "quantitative",
            "title": "Brand total, 1999–2007"
          }
        ]
      }
    }
  ],
  "background": "transparent",
  "padding": {
    "left": 0,
    "top": 5,
    "right": 80,
    "bottom": 5
  }
}