                  "leader": 1,
                  "lab_al": "left"
                },
                {
                  "partner_code": 616,
                  "lab_lon": 19,
                  "lab_lat": 52,
                  "leader": 0,
                  "lab_al": "center"
                },
                {
                  "partner_code": 410,
                  "lab_lon": 153,
                  "lab_lat": 47,
                  "leader": 1,
                  "lab_al": "left"
                },
                {
                  "partner_code": 842,
                  "lab_lon": -98,
                  "lab_lat": 39,
                  "leader": 0,
                  "lab_al": "center"
                },
                {
                  "partner_code": 764,
                  "lab_lon": 84,
                  "lab_lat": 6,
                  "leader": 1,
                  "lab_al": "right"
                },
                {
                  "partner_code": 490,
                  "lab_lon": 153,
                  "lab_lat": 26,
                  "leader": 1,
                  "lab_al": "left"
                },
                {
                  "partner_code": 276,
                  "lab_lon": 10.4,
                  "lab_lat": 51,
                  "leader": 0,
                  "lab_al": "right"
                },
                {
                  "partner_code": 484,
                  "lab_lon": -102,
                  "lab_lat": 23.6,
                  "leader": 0,
                  "lab_al": "center"
                },
                {
                  "partner_code": 124,
                  "lab_lon": -106,
                  "lab_lat": 56,
                  "leader": 0,
                  "lab_al": "center"
                },
                {
                  "partner_code": 203,
                  "lab_lon": 15.5,
                  "lab_lat": 49.8,
                  "leader": 0,
                  "lab_al": "center"
                },
                {
                  "partner_code": 752,
                  "lab_lon": 15,
                  "lab_lat": 62,
                  "leader": 0,
                  "lab_al": "center"
                }
              ]
            },
            "key": "partner_code",
            "fields": [
              "lab_lon",
              "lab_lat",
              "leader",
              "lab_al"
            ]
          }
        },
        {
          "calculate": "datum.value_usd / datum.qty_units / 0.6449",
          "as": "aud_per_camera"
        },
        {
          "calculate": "134",
          "as": "to_lon"
        },
        {
          "calculate": "-25",
          "as": "to_lat"
        },
        {
          "calculate": "datum.name",
          "as": "label"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "rule",
            "strokeCap": "round",
            "opacity": 0.9,
            "color": "#2171b5"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "longitude2": {
              "field": "to_lon"
            },
            "latitude2": {
              "field": "to_lat"
            },
            "size": {
              "field": "value_aud_m",
              "type": "quantitative",
              "scale": {
                "domain": [
                  0,
                  700
                ],
                "range": [
                  1.5,
                  16
                ],
                "zero": true
              },
              "legend": null
            },
            "tooltip": [
              {
                "field": "name",
                "type": "nominal",
                "title": "From"
              },
              {
                "field": "value_aud_m",
                "type": "quantitative",
                "title": "Value (A$ million)",
                "format": ",.1f"
              },
              {
                "field": "share",
                "type": "quantitative",
                "title": "Share of imports (%)",
                "format": ".1f"
              },
              {
                "field": "qty_units",
                "type": "quantitative",
                "title": "Cameras",
                "format": ","
              },
              {
                "field": "aud_per_camera",
                "type": "quantitative",
                "title": "Average value per camera (A$)",
                "format": ",.0f"
              }
            ]
          }
        },
        {
          "transform": [
