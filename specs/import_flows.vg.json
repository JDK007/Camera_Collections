            }
          ],
          "mark": {
            "type": "text",
            "fontSize": 12,
            "color": "#2b2a28",
            "baseline": "middle",
            "align": "right",
            "dx": -18
          },
          "encoding": {
            "longitude": {
              "field": "lab_lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lab_lat",
              "type": "quantitative"
            },
            "text": {
              "field": "label"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.partner_code == 616 || datum.partner_code == 842 || datum.partner_code == 124 || datum.partner_code == 752"
            }
          ],
          "mark": {
            "type": "text",
            "fontSize": 12,
            "color": "#2b2a28",
            "baseline": "middle",
            "align": "center",
            "dy": -13
