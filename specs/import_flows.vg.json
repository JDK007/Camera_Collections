                "format": ","
              },
              {
                "field": "aud_per_camera",
                "type": "quantitative",
                "title": "Average value per camera (A$)",
                "format": ",.0f"
              }
            ]
          }
        },
        {
          "transform": [
            {
              "filter": "datum.partner_code == 156"
            }
