{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Flow map of the ten countries Australia imported the most camera value from in each year 2017-2025 (UN Comtrade), chosen with a year slider: line width shows value.",
  "config": {
    "font": "Manrope",
    "view": {
      "stroke": null
    },
    "title": {
      "anchor": "middle",
      "fontSize": 13,
      "fontWeight": "normal",
      "color": "#52514e",
      "frame": "group",
      "offset": 12
    },
    "axis": {
      "labelColor": "#52514e",
      "titleColor": "#52514e",
      "titleFontWeight": "normal",
      "gridColor": "#e8e7e4",
      "domainColor": "#c3c2b7",
      "tickColor": "#c3c2b7"
    },
    "legend": {
      "titleLimit": 300,
      "labelLimit": 300,
      "labelColor": "#52514e",
      "titleColor": "#52514e",
      "titleFontWeight": "normal",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "layout": {
        "bottom": {
          "anchor": "middle"
        }
      }
    },
    "axisY": {
      "minExtent": 80,
      "maxExtent": 80
    }
  },
  "background": "transparent",
  "title": {
    "text": "Australia's ten biggest camera suppliers each year: the thicker the line, the more value imported",
    "subtitle": "Drag the Year slider below the map to compare 2017 to 2025. Hover over a line for exact figures.",
    "subtitleFontStyle": "italic",
    "subtitleColor": "#52514e",
    "subtitleFontSize": 12
  },
  "width": 840,
  "height": 420,
  "projection": {
    "type": "equalEarth",
    "rotate": [
      -150,
      0,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "filter": "datum.id != '010'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#e4dfd4",
        "stroke": "#faf7f2",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "filter": "datum.id == '036'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#9b2c2c",
        "stroke": "#faf7f2",
        "strokeWidth": 0.5
      },
      "encoding": {
        "tooltip": {
          "value": "Australia"
        }
      }
    },
    {
      "data": {
        "url": "data/comtrade_au_camera_imports_2017-2025.csv",
        "format": {
          "parse": {
            "year": "number",
            "partner_code": "number",
            "value_usd": "number",
            "qty_units": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.year == pick_year"
        },
        {
          "joinaggregate": [
            {
              "op": "max",
              "field": "value_usd",
              "as": "world_usd"
            }
          ]
        },
        {
          "filter": "datum.partner_code != 0 && datum.partner_code != 36"
        },
        {
          "calculate": "100 * datum.value_usd / datum.world_usd",
          "as": "share"
        },
        {
          "calculate": "datum.value_usd / 0.6449 / 1000000",
          "as": "value_aud_m"
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "rank"
            }
          ],
          "sort": [
            {
              "field": "value_usd",
              "order": "descending"
            }
          ]
        },
        {
          "filter": "datum.rank <= 10"
        },
        {
          "lookup": "partner_code",
          "from": {
            "data": {
              "values": [
                {
                  "partner_code": 156,
                  "name": "China",
                  "lon": 104,
                  "lat": 35
                },
                {
                  "partner_code": 704,
                  "name": "Vietnam",
                  "lon": 106,
                  "lat": 16
                },
                {
                  "partner_code": 392,
                  "name": "Japan",
                  "lon": 138.5,
                  "lat": 36.5
                },
                {
                  "partner_code": 616,
                  "name": "Poland",
                  "lon": 19,
                  "lat": 52
                },
                {
                  "partner_code": 410,
                  "name": "South Korea",
                  "lon": 127.8,
                  "lat": 36.4
                },
                {
                  "partner_code": 842,
                  "name": "USA",
                  "lon": -98,
                  "lat": 39
                },
                {
                  "partner_code": 764,
                  "name": "Thailand",
                  "lon": 101,
                  "lat": 15
                },
                {
                  "partner_code": 490,
                  "name": "Taiwan",
                  "lon": 121,
                  "lat": 23.7
                },
                {
                  "partner_code": 276,
                  "name": "Germany",
                  "lon": 10.4,
                  "lat": 51
                },
                {
                  "partner_code": 484,
                  "name": "Mexico",
                  "lon": -102,
                  "lat": 23.6
                },
                {
                  "partner_code": 124,
                  "name": "Canada",
                  "lon": -106,
                  "lat": 56
                },
                {
                  "partner_code": 203,
                  "name": "Czechia",
                  "lon": 15.5,
                  "lat": 49.8
                },
                {
                  "partner_code": 752,
                  "name": "Sweden",
                  "lon": 15,
                  "lat": 62
                }
              ]
            },
            "key": "partner_code",
            "fields": [
              "name",
              "lon",
              "lat"
            ]
          }
        },
        {
          "lookup": "partner_code",
          "from": {
            "data": {
              "values": [
                {
                  "partner_code": 156,
                  "lab_lon": 104,
                  "lab_lat": 35,
                  "leader": 0,
                  "lab_al": "right"
                },
                {
                  "partner_code": 704,
                  "lab_lon": 153,
                  "lab_lat": 14,
                  "leader": 1,
                  "lab_al": "left"
                },
                {
                  "partner_code": 392,
                  "lab_lon": 153,
