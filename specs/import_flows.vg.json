                "format": ".1f"
              },
              {
                "field": "qty_units",
                "type": "quantitative",
                "title": "Cameras",
                "format": ","
              },
              {
                "field": "aud_per_camera",
                "type": "quantitative",
                "title": "Average value per camera (A$)",
                "format": ",.0f"
              }
            ]
          }
        },
        {
          "transform": [
            {
              "filter": "datum.lab_al == 'left'"
            }
          ],
          "mark": {
            "type": "text",
            "fontSize": 12,
            "color": "#2b2a28",
            "baseline": "middle",
            "align": "left",
            "dx": 4
          },
          "encoding": {
            "longitude": {
              "field": "lab_lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lab_lat",
              "type": "quantitative"
            },
            "text": {
