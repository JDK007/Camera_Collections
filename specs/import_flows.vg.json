            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.partner_code == 484 || datum.partner_code == 203"
            }
          ],
          "mark": {
            "type": "text",
            "fontSize": 12,
            "color": "#2b2a28",
            "baseline": "middle",
            "align": "center",
            "dy": 14
          },
          "encoding": {
            "longitude": {
              "field": "lab_lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lab_lat",
              "type": "quantitative"
            },
            "text": {
              "field": "label"
            }
          }
        }
      ]
