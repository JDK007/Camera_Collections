{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Waterfall chart of how much each country added to the 30% rise in the value of Australia's camera imports from 2022 to 2025 (UN Comtrade).",
  "config": {
    "font": "Manrope",
    "view": {
      "stroke": null
    },
    "title": {
      "anchor": "middle",
      "fontSize": 13,
      "fontWeight": "normal",
      "color": "#52514e",
      "frame": "group",
      "offset": 12
    },
    "axis": {
      "labelColor": "#52514e",
      "titleColor": "#52514e",
      "titleFontWeight": "normal",
      "gridColor": "#e8e7e4",
      "domainColor": "#c3c2b7",
      "tickColor": "#c3c2b7"
    },
    "axisY": {
      "minExtent": 80,
      "maxExtent": 80
    }
  },
  "background": "transparent",
  "padding": {
    "left": 0,
    "top": 5,
    "right": 80,
    "bottom": 5
  },
  "title": {
    "text": "Where Australia's 30% rise in camera imports came from, 2022 to 2025",
    "subtitle": "Each bar shows how much of the rise came from one country, in percentage points",
    "subtitleFontStyle": "italic",
    "subtitleColor": "#52514e",
    "subtitleFontSize": 13,
    "subtitlePadding": 4
  },
  "width": 840,
  "height": 340,
  "layer": [
    {
      "data": {
        "url": "data/comtrade_au_camera_imports_2022-2025.csv",
        "format": {
          "parse": {
            "year": "number",
            "partner_code": "number",
            "value_usd": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.year == 2022 || datum.year == 2025"
        },
        {
          "pivot": "year",
          "value": "value_usd",
          "groupby": [
            "partner_code",
            "partner"
          ]
        },
        {
          "calculate": "isValid(datum['2022']) ? datum['2022'] : 0",
          "as": "v2022"
        },
        {
          "calculate": "isValid(datum['2025']) ? datum['2025'] : 0",
          "as": "v2025"
        },
        {
          "joinaggregate": [
            {
              "op": "max",
              "field": "v2022",
              "as": "world_2022"
            }
          ]
        },
        {
          "filter": "datum.partner_code != 0"
        },
        {
          "calculate": "100 * (datum.v2025 - datum.v2022) / datum.world_2022",
          "as": "points"
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "rank"
            }
          ],
          "sort": [
            {
              "field": "points",
              "order": "descending"
            }
          ]
        },
        {
          "calculate": "datum.rank <= 7 ? (datum.partner == 'Viet Nam' ? 'Vietnam' : datum.partner == 'Rep. of Korea' ? 'South Korea' : datum.partner) : 'All other countries'",
          "as": "label"
        },
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "points",
              "as": "points"
            }
          ],
          "groupby": [
            "label"
          ]
        },
        {
          "calculate": "indexof([\"China\", \"Vietnam\", \"Japan\", \"Poland\", \"South Korea\", \"Myanmar\", \"Mexico\", \"All other countries\", \"Total rise\"], datum.label)",
          "as": "order"
        },
        {
          "window": [
            {
              "op": "sum",
              "field": "points",
              "as": "end"
            }
          ],
          "sort": [
            {
              "field": "order"
            }
          ]
        },
        {
          "calculate": "datum.end - datum.points",
          "as": "start"
        },
        {
          "calculate": "(datum.points >= 0 ? '+' : '') + format(datum.points, '.1f')",
          "as": "text"
        },
        {
          "calculate": "indexof(['Vietnam', 'Myanmar', 'Mexico'], datum.label) >= 0 ? 'Fastest-growing' : 'Other'",
          "as": "growth_group"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "bar",
            "cornerRadius": 2
          },
          "encoding": {
            "x": {
              "field": "label",
              "type": "nominal",
              "title": null,
              "sort": [
                "China",
                "Vietnam",
                "Japan",
                "Poland",
                "South Korea",
                "Myanmar",
                "Mexico",
                "All other countries",
                "Total rise"
              ],
              "scale": {
                "domain": [
                  "China",
                  "Vietnam",
                  "Japan",
                  "Poland",
                  "South Korea",
                  "Myanmar",
                  "Mexico",
                  "All other countries",
                  "Total rise"
                ],
                "paddingInner": 0.25
              },
              "axis": {
                "labelAngle": 0,
                "labelFontSize": 12,
                "labelColor": "#2b2a28",
                "ticks": false
              }
            },
            "y": {
              "field": "start",
              "type": "quantitative",
              "title": null,
              "scale": {
                "domain": [
                  0,
                  36
                ]
              },
              "axis": {
                "values": [
                  0,
                  10,
                  20,
                  30
                ],
                "labelExpr": "'+' + datum.value + '%'",
                "grid": true
              }
            },
            "y2": {
              "field": "end"
            },
            "tooltip": [
              {
                "field": "label",
                "title": "Country"
              },
              {
                "field": "points",
                "type": "quantitative",
                "title": "Added to the rise (percentage points)",
                "format": "+.1f"
              }
            ],
            "color": {
              "field": "growth_group",
              "type": "nominal",
              "scale": {
                "domain": [
                  "Fastest-growing",
                  "Other"
                ],
                "range": [
                  "#b5585a",
                  "#dcb3b3"
                ]
              },
              "legend": null
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "dy": -8,
            "fontSize": 12,
            "fontWeight": 600,
            "color": "#7a2222"
          },
          "encoding": {
            "x": {
              "field": "label",
              "type": "nominal",
              "title": null,
              "sort": [
                "China",
                "Vietnam",
                "Japan",
                "Poland",
                "South Korea",
                "Myanmar",
                "Mexico",
                "All other countries",
                "Total rise"
              ],
              "scale": {
                "domain": [
                  "China",
                  "Vietnam",
                  "Japan",
                  "Poland",
                  "South Korea",
                  "Myanmar",
                  "Mexico",
                  "All other countries",
                  "Total rise"
                ],
                "paddingInner": 0.25
              },
              "axis": {
                "labelAngle": 0,
                "labelFontSize": 12,
                "labelColor": "#2b2a28",
                "ticks": false
              }
            },
            "y": {
              "field": "end",
              "type": "quantitative",
              "scale": {
                "domain": [
                  0,
                  36
                ]
              }
            },
            "text": {
              "field": "text"
            }
          }
        }
      ]
    },
    {
      "data": {
        "url": "data/comtrade_au_camera_imports_2022-2025.csv",
        "format": {
          "parse": {
            "year": "number",
            "partner_code": "number",
            "value_usd": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.partner_code == 0"
        },
        {
          "window": [
            {
              "op": "first_value",
              "field": "value_usd",
              "as": "base"
            }
          ],
          "sort": [
            {
              "field": "year"
            }
          ],
          "frame": [
            null,
            null
          ]
        },
        {
          "filter": "datum.year == 2025"
        },
        {
          "calculate": "100 * (datum.value_usd / datum.base - 1)",
          "as": "end"
        },
        {
          "calculate": "0",
          "as": "start"
        },
        {
          "calculate": "'Total rise'",
          "as": "label"
        },
        {
          "calculate": "'+' + format(datum.end, '.1f') + '%'",
          "as": "text"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "bar",
            "cornerRadius": 2,
            "color": "#9b2c2c"
          },
          "encoding": {
            "x": {
              "field": "label",
              "type": "nominal",
              "title": null,
              "sort": [
                "China",
                "Vietnam",
                "Japan",
                "Poland",
                "South Korea",
                "Myanmar",
                "Mexico",
                "All other countries",
                "Total rise"
              ],
              "scale": {
                "domain": [
                  "China",
                  "Vietnam",
                  "Japan",
                  "Poland",
                  "South Korea",
                  "Myanmar",
                  "Mexico",
                  "All other countries",
                  "Total rise"
                ],
                "paddingInner": 0.25
              },
              "axis": {
                "labelAngle": 0,
                "labelFontSize": 12,
                "labelColor": "#2b2a28",
                "ticks": false
              }
            },
            "y": {
              "field": "start",
              "type": "quantitative",
              "title": null,
              "scale": {
                "domain": [
                  0,
                  36
                ]
              },
              "axis": {
                "values": [
                  0,
                  10,
                  20,
                  30
                ],
                "labelExpr": "'+' + datum.value + '%'",
                "grid": true
              }
            },
            "y2": {
              "field": "end"
            },
            "tooltip": [
              {
                "field": "text",
                "title": "Rise in Australia's camera imports, 2022 to 2025"
              }
            ]
          }
        },
        {
          "mark": {
            "type": "text",
            "dy": -8,
            "fontSize": 12,
            "fontWeight": 700,
            "color": "#7a2222"
          },
          "encoding": {
            "x": {
              "field": "label",
              "type": "nominal",
              "title": null,
              "sort": [
                "China",
                "Vietnam",
                "Japan",
                "Poland",
                "South Korea",
                "Myanmar",
                "Mexico",
                "All other countries",
                "Total rise"
              ],
              "scale": {
                "domain": [
                  "China",
                  "Vietnam",
                  "Japan",
                  "Poland",
                  "South Korea",
                  "Myanmar",
                  "Mexico",
                  "All other countries",
                  "Total rise"
                ],
                "paddingInner": 0.25
              },
              "axis": {
                "labelAngle": 0,
                "labelFontSize": 12,
                "labelColor": "#2b2a28",
                "ticks": false
              }
            },
            "y": {
              "field": "end",
              "type": "quantitative",
              "scale": {
                "domain": [
                  0,
                  36
                ]
              }
            },
            "text": {
              "field": "text"
            }
          }
        }
      ]
    },
    {
      "data": {
        "values": [
          {
            "y": 34.5
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "x": 8,
        "baseline": "middle",
        "fontSize": 12,
        "fontStyle": "italic",
        "color": "#7a2222"
      },
      "encoding": {
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              36
            ]
          }
        },
        "text": {
          "value": "Darker bars: fastest-growing suppliers (Vietnam +82%, Mexico +106%, Myanmar up from almost nothing)"
        }
      }
    }
  ]
}