{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "The megapixel race: the megapixels of every camera model in the 1000 Cameras Dataset, 1994-2007, with the typical (median) camera each year. A drop-down menu highlights one brand's cameras.",
  "config": {
    "font": "Manrope",
    "view": {
      "stroke": null
    },
    "title": {
      "anchor": "middle",
      "fontSize": 13,
      "fontWeight": "normal",
      "color": "#52514e",
      "frame": "group",
      "offset": 12
    },
    "axis": {
      "labelColor": "#52514e",
      "titleColor": "#52514e",
      "titleFontWeight": "normal",
      "gridColor": "#e8e7e4",
      "domainColor": "#c3c2b7",
      "tickColor": "#c3c2b7"
    },
    "axisY": {
      "minExtent": 80,
      "maxExtent": 80
    },
    "legend": {
      "layout": {
        "bottom": {
          "anchor": "middle"
        }
      }
    }
  },
  "vconcat": [
    {
      "title": "Megapixels of every camera in the 1000 Cameras Dataset, 1994–2007 (each dot is one model)",
      "width": 840,
      "height": 340,
      "data": {
        "url": "data/cameras_1000_specs_1994-2007.csv",
        "format": {
          "type": "csv",
          "parse": {
            "Release date": "number",
            "Effective pixels": "number"
          }
        }
      },
      "transform": [
        {
          "calculate": "datum['Release date']",
          "as": "year"
        },
        {
          "calculate": "datum['Effective pixels']",
          "as": "megapixels"
        }
      ],
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "scale": {
            "domain": [
              1993.7,
              2007.3
            ],
            "nice": false
          },
          "axis": {
            "format": "d",
            "tickCount": 14,
            "title": "Release year",
            "grid": false
          }
        },
        "y": {
          "field": "megapixels",
          "type": "quantitative",
          "title": null,
          "scale": {
            "domain": [
              0,
              22
            ]
          }
        }
      },
      "layer": [
        {
          "transform": [
            {
              "calculate": "datum.year + (random() - 0.5) * 0.6",
              "as": "year_jittered"
            },
            {
              "calculate": "split(datum.Model, ' ')[0]",
              "as": "brand"
            }
          ],
          "mark": {
            "type": "circle",
            "size": 34,
            "clip": true
          },
          "encoding": {
            "x": {
              "field": "year_jittered",
              "type": "quantitative",
              "scale": {
                "domain": [
                  1993.7,
                  2007.3
                ],
                "nice": false
              },
              "axis": {
                "format": "d",
                "tickCount": 14,
                "title": "Release year",
                "grid": false
              }
            },
            "tooltip": [
              {
                "field": "Model",
                "type": "nominal",
                "title": "Camera"
              },
              {
                "field": "brand",
                "type": "nominal",
                "title": "Brand"
              },
              {
                "field": "year",
                "type": "quantitative",
                "title": "Released",
                "format": "d"
              },
              {
                "field": "megapixels",
                "type": "quantitative",
                "title": "Megapixels"
              }
            ],
            "opacity": {
              "condition": [
                {
                  "test": "brand_pick == 'All brands'",
                  "value": 0.35
                },
                {
                  "test": "datum.brand == brand_pick",
                  "value": 0.9
                }
              ],
              "value": 0.08
            },
            "color": {
              "condition": {
                "test": "brand_pick != 'All brands' && datum.brand != brand_pick",
                "value": "#a9a59b"
              },
              "value": "#2a78d6"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.year >= 1997"
            },
            {
              "aggregate": [
                {
                  "op": "median",
                  "field": "megapixels",
                  "as": "megapixels"
                }
              ],
              "groupby": [
                "year"
              ]
            }
          ],
          "mark": {
            "type": "line",
            "color": "#1a4f8f",
            "strokeWidth": 2.5,
            "point": {
              "filled": true,
              "size": 50,
              "color": "#1a4f8f"
            }
          },
          "encoding": {
            "tooltip": [
              {
                "field": "year",
                "type": "quantitative",
                "title": "Year",
                "format": "d"
              },
              {
                "field": "megapixels",
                "type": "quantitative",
                "title": "Typical camera (megapixels)"
              }
            ]
          }
        },
        {
          "data": {
            "values": [
              {
                "year": 1994.2,
                "megapixels": 20.5
              }
            ]
          },
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "fontSize": 13,
            "fontWeight": "bold",
            "color": "#1a4f8f",
            "lineHeight": 18
          },
          "encoding": {
            "text": {
              "value": [
                "The typical camera (dark blue line) went from",
                "under 1 MP in 1997 to 8 MP in 2007."
              ]
            }
          }
        }
      ]
    }
  ],
  "background": "transparent",
  "padding": {
    "left": 0,
    "top": 5,
    "right": 80,
    "bottom": 5
  },
  "spacing": 48,
  "params": [
    {
      "name": "brand_pick",
      "value": "All brands",
      "bind": {
        "input": "select",
        "options": [
          "All brands",
          "Canon",
          "Casio",
          "Fujifilm",
          "Kodak",
          "Nikon",
          "Olympus",
          "Panasonic",
          "Pentax",
          "Samsung",
          "Sony"
        ],
        "name": "Highlight a brand "
      }
    }
  ]
}